local WHITE = Color3.new(1, 1, 1)
local GLOW_IMAGE = "rbxassetid://6014261993"
local GLOW_SLICE = Rect.new(49, 49, 450, 450)
local BASE_WIDTH, BASE_HEIGHT = 440, 406

local function kindStyle(kind)
    local styles = {
        info = { theme.Cyan, "i" },
        loading = { theme.Cyan, "…" },
        success = { theme.Green, "✓" },
        warn = { theme.Amber, "!" },
        error = { theme.Red, "×" },
    }
    local style = styles[kind or "info"] or styles.info
    return { Color = style[1], Icon = style[2] }
end

local function make(class, props, parent)
    local object = Instance.new(class)
    for key, value in pairs(props or {}) do
        object[key] = value
    end
    object.Parent = parent
    return object
end

local function tween(object, time, props, style, direction)
    local info = TweenInfo.new(time, style or Enum.EasingStyle.Quart, direction or Enum.EasingDirection.Out)
    local t = TweenService:Create(object, info, props)
    t:Play()
    return t
end

local function addCorner(parent, radius)
    return make("UICorner", { CornerRadius = UDim.new(0, radius or 10) }, parent)
end

local function addStroke(parent, color, thickness, transparency)
    return make("UIStroke", {
        Color = color or theme.Stroke,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, parent)
end

local function addGradient(parent, colorA, colorB, rotation)
    return make("UIGradient", { Color = ColorSequence.new(colorA, colorB), Rotation = rotation or 0 }, parent)
end

local function addPadding(parent, left, top, right, bottom)
    return make("UIPadding", {
        PaddingLeft = UDim.new(0, left),
        PaddingTop = UDim.new(0, top),
        PaddingRight = UDim.new(0, right),
        PaddingBottom = UDim.new(0, bottom),
    }, parent)
end

local function addGlow(parent, color, extra, transparency, zIndex)
    return make("ImageLabel", {
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.new(1, extra, 1, extra),
        Image = GLOW_IMAGE,
        ImageColor3 = color,
        ImageTransparency = transparency,
        ScaleType = Enum.ScaleType.Slice,
        SliceCenter = GLOW_SLICE,
        ZIndex = zIndex or 1,
    }, parent)
end

local function pulse(object, prop, from, to, time)
    object[prop] = from
    local info = TweenInfo.new(time or 1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
    TweenService:Create(object, info, { [prop] = to }):Play()
end

local function makeLabel(parent, props)
    props.BackgroundTransparency = props.BackgroundTransparency or 1
    props.ZIndex = props.ZIndex or 5
    props.Font = props.Font or Enum.Font.Gotham
    props.TextColor3 = props.TextColor3 or theme.Text
    props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
    return make("TextLabel", props, parent)
end

local function gradientButton(parent, text, size, position, colorA, colorB)
    local holder = make("Frame", {
        Size = size,
        Position = position,
        BackgroundColor3 = WHITE,
        BorderSizePixel = 0,
        ZIndex = 5,
    }, parent)
    addCorner(holder, 10)
    local gradient = addGradient(holder, colorA, colorB, 20)
    local outline = addStroke(holder, WHITE, 1, 0.85)

    local button = make("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        AutoButtonColor = false,
        Text = text,
        TextColor3 = WHITE,
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        ZIndex = 6,
    }, holder)

    button.MouseEnter:Connect(function()
        tween(outline, 0.18, { Transparency = 0.3 })
        tween(gradient, 0.45, { Rotation = 200 })
    end)
    button.MouseLeave:Connect(function()
        tween(outline, 0.18, { Transparency = 0.85 })
        tween(gradient, 0.45, { Rotation = 20 })
    end)
    return button
end

local function iconButton(parent, text, position, hoverColor)
    local button = make("TextButton", {
        Size = UDim2.fromOffset(28, 28),
        Position = position,
        BackgroundColor3 = theme.Card,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Text = text,
        TextColor3 = theme.Muted,
        TextSize = 16,
        Font = Enum.Font.GothamBold,
        ZIndex = 6,
    }, parent)
    addCorner(button, 8)
    addStroke(button, theme.Stroke, 1)
    button.MouseEnter:Connect(function()
        tween(button, 0.15, { BackgroundColor3 = hoverColor, TextColor3 = theme.Text })
    end)
    button.MouseLeave:Connect(function()
        tween(button, 0.15, { BackgroundColor3 = theme.Card, TextColor3 = theme.Muted })
    end)
    return button
end

local function getContainers()
    local list = { CoreGui }
    local playerGui = player and player:FindFirstChildOfClass("PlayerGui")
    if playerGui then
        table.insert(list, playerGui)
    end
    if gethui then
        local ok, hui = pcall(gethui)
        if ok and hui then
            table.insert(list, hui)
        end
    end
    return list
end

local function removeGui(name)
    for _, container in ipairs(getContainers()) do
        pcall(function()
            local old = container:FindFirstChild(name)
            if old then
                old:Destroy()
            end
        end)
    end
end

local function newScreenGui(name, displayOrder)
    local gui = make("ScreenGui", {
        Name = name,
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = displayOrder,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    })
    local ok = pcall(function()
        gui.Parent = gethui and gethui() or CoreGui
    end)
    if not ok or not gui.Parent then
        gui.Parent = player:WaitForChild("PlayerGui")
    end
    return gui
end

