        end
    end)

    -- dragging by the top bar
    local dragging, dragStart, startPosition, dragInput = false, nil, nil, nil

    local function isPointer(input)
        return input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch
    end

    topBar.InputBegan:Connect(function(input)
        if not isPointer(input) then return end
        dragging = true
        dragStart = input.Position
        startPosition = root.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end)

    topBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    connect(UserInputService.InputChanged, function(input)
        if input == dragInput and dragging then
            local delta = (input.Position - dragStart) / rootScale.Scale
            root.Position = UDim2.new(
                startPosition.X.Scale, startPosition.X.Offset + delta.X,
                startPosition.Y.Scale, startPosition.Y.Offset + delta.Y
            )
        end
    end)

    -- background animation, paused while minimized
    local elapsed = 0
    connect(RunService.Heartbeat, function(dt)
        if hidden then return end
        elapsed = elapsed + dt
        borderGradient.Rotation = (elapsed * 45) % 360
        logoGradient.Rotation = (elapsed * 60) % 360
        tealOrb.Position = UDim2.fromScale(0.12 + math.sin(elapsed * 0.5) * 0.07, 0.1 + math.cos(elapsed * 0.4) * 0.06)
        violetOrb.Position = UDim2.fromScale(0.95 + math.cos(elapsed * 0.45) * 0.07, 0.95 + math.sin(elapsed * 0.35) * 0.06)
    end)

    ------------------------------------------------------------
    -- startup
    ------------------------------------------------------------
    tween(rootScale, 0.4, { Scale = targetScale }, Enum.EasingStyle.Back)
    setStatus("Connecting to key service...", theme.Cyan)

    if savedKey ~= "" then
        keyBox.Text = savedKey
    end

    task.spawn(function()
        while not sdkDone and not destroyed do
            task.wait()
        end
        if destroyed then return end

        if not sdkLib then
            startupError = "Junkie SDK failed to load  •  Check your connection and SDKUrl"
            problem("error", "Key service unreachable  •  Check your connection",
                "SDK failed", "Could not load the Junkie SDK. Check your connection.", { Duration = 6, Tag = "sdk" })
            return
        end

        local j = cfg.Junkie
        local service = cleanText(pickByTier(j.Service, isPremium), nil)
        if not service then
            startupError = "Junkie config missing  •  Set Junkie.Service"
            problem("error", "Junkie config missing  •  Set Junkie.Service",
                "Config missing", "Set Junkie.Service in Launcher.", { Duration = 8, Tag = "sdk" })
            return
        end

        junkie = sdkLib
        junkie.service = service
        junkie.identifier = cleanText(pickByTier(j.Identifier, isPremium), "")
        junkie.provider = cleanText(pickByTier(j.Provider, isPremium), nil)

        -- set now, resolved again after verify since the key's tier can pick another script
        local startSource = resolveLoadSource(j.ScriptId, isPremium)
        if startSource.Id then
            junkie.script_id = startSource.Id
        end

        if savedKey ~= "" then
            if autoOn then
                setStatus("Saved key found  •  Verifying...", theme.Cyan)
                task.wait(0.8)
                if not destroyed then
                    verify()
                end
            else
                setStatus("Saved key found  •  Press VERIFY KEY", theme.Cyan)
            end
        else
            setStatus("Ready  •  Get a key or paste yours", theme.Green)
            task.spawn(fetchLink)
        end
    end)

    -- Blocks until a key is accepted. If the window is closed first it never
    -- returns, so whatever comes after Launcher() never runs.
    local function waitForKey()
        while not verified do
            if destroyed then
                while true do
                    task.wait(1)
                end
            end
            task.wait(0.1)
        end
    end

    handle.Destroy = destroyUi
    handle.Show = function() setHidden(false) end
    handle.Hide = function() setHidden(true) end
    handle.SetStatus = setStatus
    handle.Wait = waitForKey
    handle.IsVerified = function() return verified end
    Toolkit._Active = handle

    if cfg.WaitForKey == true then
        waitForKey()
    end

    return handle
end

----------------------------------------------------------------
-- headless junkie checks (no gui)
--
--   Toolkit:CheckKey(key, options) -> result
--     options: Premium (false | true | "both"), EnforceTier, LoadScript,
--              Service / Identifier / Provider / ScriptId (or inside Junkie = {}),
--              Games / GamesUrl, SDK (an already loaded Junkie lib)
--     result:  Valid, IsPremium, Tier, Reason, Error, Raw, Game
--              Load() -> ok, err, reason     (only when Valid)
--     Reason when not valid:
--       missing config sdk request invalid expired hwid mismatch banned rate
--       service premium_in_freemium freemium_in_premium
--
--   Toolkit:VerifyAndLoad(key, options)
--     CheckKey + Load in one go. Adds Loaded, LoadError, LoadReason to the result.
--
--   local result = Toolkit:VerifyAndLoad(key, {
--       Premium = "both",
--       Service = "My Service", Identifier = "12345",
--       ScriptId = { Premium = "<token>", Freemium = "<token>" },
--   })
--   if not result.Valid then warn(result.Reason) end
----------------------------------------------------------------

function Toolkit:CheckKey(key, options)
    local cfg = deepMerge({
        Premium = Toolkit.Defaults.Premium,
        EnforceTier = Toolkit.Defaults.EnforceTier,
        LoadScript = Toolkit.Defaults.LoadScript,
        Junkie = Toolkit.Defaults.Junkie,
    }, options)

    local result = { Valid = false, IsPremium = false, Tier = nil, Reason = nil, Error = nil, Raw = nil }

    key = trim(key)
    if key == "" then
        result.Reason = "missing"
        return result
    end

    local j = cfg.Junkie
    for _, name in ipairs({ "Service", "Identifier", "Provider", "ScriptId" }) do
        if cfg[name] ~= nil then
            j[name] = cfg[name]
        end
    end

    local games = cfg.Games
    if type(games) ~= "table" and type(cfg.GamesUrl) == "string" and cfg.GamesUrl ~= "" then
        games = fetchGames(cfg.GamesUrl)
    end
    local gameEntry = findGame(games)
    if gameEntry then
        result.Game = gameEntry
        j.ScriptId = { Premium = gameEntry.Premium, Freemium = gameEntry.Freemium }
    end

    local launcherPremium = cfg.Premium == true
    local service = cleanText(pickByTier(j.Service, launcherPremium), nil)
    local identifier = cleanText(pickByTier(j.Identifier, launcherPremium), "")
    local provider = cleanText(pickByTier(j.Provider, launcherPremium), nil)

    if not service then
        result.Reason = "config"
        result.Error = "Junkie.Service is missing"
        return result
    end

    local lib = cfg.SDK
    if not lib then
        local loaded, err = loadSdk(j.SDKUrl)
        if not loaded then
            result.Reason = "sdk"
            result.Error = err
            return result
        end
        lib = loaded
    end

    lib.service = service
    lib.identifier = identifier
    lib.provider = provider

    local startSource = resolveLoadSource(j.ScriptId, launcherPremium)
    if startSource.Id then
        lib.script_id = startSource.Id
    end

    local ok, response = pcall(lib.check_key, key)
    if not ok or type(response) ~= "table" then
        result.Reason = "request"
        result.Error = ok and "bad response" or tostring(response)
        return result
    end
    result.Raw = response

    if not response.valid then
        result.Error = response.error or response.message
        result.Reason = classifyError(result.Error)
        return result
    end

    local keyIsPremium = response.is_premium == true
    result.IsPremium = keyIsPremium
    result.Tier = keyIsPremium and "Premium" or "Freemium"

    local anyTier = cfg.Premium == "both" or cfg.Premium == "auto"
    local wantPremium = cfg.Premium == true
    if cfg.EnforceTier ~= false and not anyTier then
        if keyIsPremium and not wantPremium then
            result.Reason = "premium_in_freemium"
            return result
        end
        if (not keyIsPremium) and wantPremium then
            result.Reason = "freemium_in_premium"
            return result
        end
    end

    result.Valid = true

    local loaded, running = false, false
    result.Load = function()
        if loaded then
            return true
        end
        if running then
            return false, "a load is already in progress", "busy"
        end

        running = true
        env.SCRIPT_KEY = key
        env.TOOLKIT_KEY_PREMIUM = keyIsPremium
        local source = resolveLoadSource(j.ScriptId, keyIsPremium)
        local good, reason, detail, sdkErr = loadProtected(lib, key, source)
        running = false

        if good then
            loaded = true
            return true
        end
        return false, loadFailureLog(reason, detail, sdkErr), reason
    end

    return result
end

function Toolkit:VerifyAndLoad(key, options)
    local result = Toolkit:CheckKey(key, options)
    if not result.Valid then
        return result
    end

    local ok, loaded, err, reason = pcall(result.Load)
    result.Loaded = ok and loaded == true
    if not result.Loaded then
        result.LoadError = ok and err or tostring(loaded)
        result.LoadReason = ok and reason or "runtime"
        warn("[Toolkit] load failed: " .. tostring(result.LoadError))
    end
    return result
end

-- reachable from other scripts after the key window is gone: getgenv().Toolkit:Notify(...)
env.Toolkit = Toolkit

return Toolkit
