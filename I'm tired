local function deepMerge(base, overrides)
    local out = {}
    for key, value in pairs(base) do
        out[key] = type(value) == "table" and deepMerge(value, {}) or value
    end
    for key, value in pairs(overrides or {}) do
        if type(value) == "table" and type(out[key]) == "table" then
            out[key] = deepMerge(out[key], value)
        else
            out[key] = value
        end
    end
    return out
end

----------------------------------------------------------------
-- small helpers
----------------------------------------------------------------

local UUID_PATTERN = "%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x"

local function trim(text)
    return (tostring(text or ""):match("^%s*(.-)%s*$"))
end

-- Turns a script id or link into usable pieces.
--   parseScript("https://api.jnkie.com/api/v1/luascripts/public/<id>/download")
--   --> { "<id>" }, "<that link>", false
-- third value is true when text was given but isn't a link or an id.
local function parseScript(value)
    local text = trim(value)
    text = text:gsub("^[\"'`]+", ""):gsub("[\"'`]+$", "")
    text = trim(text)
    if text == "" then
        return {}, nil, false
    end

    local tokens, seen = {}, {}
    local function add(token)
        if not seen[token] then
            seen[token] = true
            table.insert(tokens, token)
        end
    end

    if text:match("^https?://") then
        if not text:match("^https?://[^%s/]+%S*$") then
            return {}, nil, true
        end
        local pathId = text:match("/luascripts/public/([%w_%-]+)/download")
        if pathId then
            add(pathId)
        end
        if #tokens == 0 then
            for part in text:gmatch(UUID_PATTERN) do
                add(part)
            end
        end
        return tokens, text, false
    end

    for part in text:gmatch(UUID_PATTERN) do
        add(part)
    end
    for part in text:gmatch("%w+") do
        if #part >= 32 and part:match("^%x+$") then
            add(part)
        end
    end
    return tokens, nil, #tokens == 0
end

-- pickByTier({ Premium = "a", Freemium = "b" }, true) --> "a"
-- plain values pass through untouched.
local function pickByTier(value, isPremium)
    if type(value) == "table" then
        local chosen = isPremium and value.Premium or value.Freemium
        return chosen or value.Default
    end
    return value
end

-- numbers become text, spaces are trimmed, empty / table / boolean fall back
local function cleanText(value, default)
    if value == nil or type(value) == "table" or type(value) == "boolean" then
        return default
    end
    local text = trim(value)
    if text == "" then
        return default
    end
    return text
end

-- junkie error string -> banned | expired | mismatch | hwid | rate | service | invalid
local function classifyError(err)
    local text = string.upper(tostring(err or ""))
    if text:find("BANNED") then return "banned" end
    if text:find("EXPIRED") then return "expired" end
    if text:find("SERVICE_MISMATCH") then return "mismatch" end
    if text:find("HWID") then return "hwid" end
    if text:find("RATE_LIMIT") then return "rate" end
    if text:find("SERVICE") or text:find("IDENTIFIER") or text:find("PROVIDER") then
        return "service"
    end
    return "invalid"
end

local function findGame(games)
    if type(games) ~= "table" then
        return nil
    end
    local placeId, gameId = tostring(game.PlaceId), tostring(game.GameId)
    for _, entry in ipairs(games) do
        if type(entry) == "table" then
            if entry.PlaceId ~= nil and tostring(entry.PlaceId) == placeId then
                return entry
            end
            if entry.GameId ~= nil and tostring(entry.GameId) == gameId then
                return entry
            end
            if type(entry.PlaceIds) == "table" then
                for _, id in ipairs(entry.PlaceIds) do
                    if tostring(id) == placeId then
                        return entry
                    end
                end
            end
        end
    end
    return nil
end

function Toolkit:ResolveGame(games)
    return findGame(games)
end

local function escapeRich(text)
    return (tostring(text or ""):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

-- both accept a Color3 or "#RRGGBB" / "RRGGBB"
local function toHex(value, fallback)
    if typeof(value) == "Color3" then
        return value:ToHex()
    end
    if type(value) == "string" then
        local hex = value:gsub("^%s*#?", ""):gsub("%s*$", "")
        if hex:match("^%x%x%x%x%x%x$") then
            return hex:lower()
        end
    end
    return fallback:ToHex()
end

local function toColor3(value, fallback)
    if typeof(value) == "Color3" then
        return value
    end
    if type(value) == "string" then
        local hex = value:gsub("^%s*#?", ""):gsub("%s*$", "")
        if hex:match("^%x%x%x%x%x%x$") then
            return Color3.fromRGB(
                tonumber(hex:sub(1, 2), 16),
                tonumber(hex:sub(3, 4), 16),
                tonumber(hex:sub(5, 6), 16)
            )
        end
    end
    return fallback
end

local function copyText(text)
    local copy = setclipboard or toclipboard or (syn and syn.write_clipboard)
    return copy ~= nil and (pcall(copy, text))
end

local function readFile(path)
    local ok, data = pcall(function()
        if isfile and readfile and isfile(path) then
            return readfile(path)
        end
        return ""
    end)
    return (ok and type(data) == "string") and data or ""
end

local function writeFile(path, data)
    pcall(function()
        if writefile then
            writefile(path, data)
        end
    end)
end

local function deleteFile(path)
    pcall(function()
        if delfile and isfile and isfile(path) then
            delfile(path)
        end
    end)
end

----------------------------------------------------------------
-- http
----------------------------------------------------------------

local statusNames = {
    [400] = "bad request",
    [401] = "unauthorized",
    [403] = "forbidden",
    [404] = "not found",
    [429] = "rate limited",
    [500] = "server error",
    [502] = "bad gateway",
    [503] = "service unavailable",
}

local function describeStatus(code)
    local name = statusNames[code]
    return "HTTP " .. tostring(code) .. (name and (" (" .. name .. ")") or "")
end

-- error pages come back as html and must never reach loadstring
local HTML_ERROR = "server returned an HTML page instead of a script"

local function isHtml(body)
    local head = body:sub(1, 400):gsub("^\239\187\191", ""):gsub("^%s+", ""):lower()
    return head:find("^<!doctype") ~= nil
        or head:find("^<html") ~= nil
        or head:find("^<head") ~= nil
        or head:find("^<body") ~= nil
end

local function getRequestFunction()
    return (syn and syn.request) or (http and http.request) or http_request
        or (fluxus and fluxus.request) or request
end

-- GET a url. Returns body, or nil + error text + status code when known.
-- The executor request function goes first (it exposes the status code),
-- game:HttpGet is the fallback.
local function httpGet(url)
    url = trim(url)
    if not url:match("^https?://[^%s/]+%S*$") then
        return nil, "invalid URL"
    end

    local request = getRequestFunction()
    if request then
        local ok, response = pcall(function()
            return request({ Url = url, Method = "GET" })
        end)
        if ok and type(response) == "table" then
            local code = tonumber(response.StatusCode) or tonumber(response.Status)
            if code and (code < 200 or code >= 300) then
                return nil, describeStatus(code), code
            end
            if type(response.Body) == "string" and response.Body ~= "" then
                if isHtml(response.Body) then
                    return nil, HTML_ERROR, code
                end
                return response.Body, nil, code
            end
            if code then
                return nil, "empty response", code
            end
        end
    end

    local ok, body = pcall(function()
        return game:HttpGet(url)
    end)
    if not ok then
        local code = tonumber(tostring(body):match("HTTP%s*(%d%d%d)"))
        if code then
            return nil, describeStatus(code), code
        end
        return nil, tostring(body)
    end
    if type(body) ~= "string" or body == "" then
        return nil, "empty response"
    end
    if isHtml(body) then
        return nil, HTML_ERROR
    end
    return body
end

local function fetchGames(url)
    local ok, result = pcall(function()
        local source, err = httpGet(url)
        if type(source) ~= "string" then
            error(err or "empty response", 0)
        end
        local compiled, compileErr = loadstring(source)
        if not compiled then
            error(compileErr)
        end
        return compiled()
    end)
    if ok and type(result) == "table" then
        return result
    end
    warn("[Toolkit] GamesUrl failed to load: " .. tostring(result))
    return nil
end

local function loadSdk(url)
    local ok, lib = pcall(function()
        local source, err = httpGet(url)
        if type(source) ~= "string" then
            error(err or "empty response", 0)
        end
        return loadstring(source)()
    end)
    if ok and lib then
        return lib
    end
    return nil, tostring(lib)
end

----------------------------------------------------------------
-- script loading
----------------------------------------------------------------

local function resolveLoadSource(scriptId, isPremium)
    local value = pickByTier(scriptId, isPremium)
    local tokens, link, invalid = parseScript(value)
    return {
        Id = tokens[1],
        Link = link,
        Given = trim(value) ~= "",
        Invalid = invalid,
        Text = trim(value),
    }
end

local function sdkLoadResult(ok, a, b)
    if not ok then
        return false, tostring(a)
    end
    if a == false then
        return false, tostring(b or "load_script returned false")
    end
    if a == nil and b ~= nil then
        return false, tostring(b)
    end
    if type(a) == "table" and (a.success == false or a.error ~= nil) then
        return false, tostring(a.error or a.message or "load_script failed")
    end
    return true
end

-- returns true, or false + reason ("http" | "compile" | "runtime") + detail
local function downloadAndRun(url, key)
    local body, err, code = httpGet(url)
    if not body and (code == 401 or code == 403) and not url:find("[?&]key=") then
        local joiner = url:find("?", 1, true) and "&" or "?"
        body, err = httpGet(url .. joiner .. "key=" .. HttpService:UrlEncode(key))
    end
    if not body then
        return false, "http", err
    end

    local pcallOk, compiled, compileErr = pcall(loadstring, body)
    if not pcallOk then
        return false, "compile", tostring(compiled)
    end
    if not compiled then
        return false, "compile", tostring(compileErr)
    end

    local runOk, runErr = pcall(compiled)
    if not runOk then
        return false, "runtime", tostring(runErr)
    end
    return true
end

-- Loads the protected script for a verified key. The SDK goes first (load_script
-- reads getgenv().SCRIPT_KEY), a direct download is only the fallback.
-- returns true, or false + reason + detail + sdkError
-- reason: "bad_url" | "no_source" | "sdk" | "http" | "compile" | "runtime"
local function loadProtected(lib, key, source)
    if source.Invalid then
        return false, "bad_url", source.Text
    end
    if not source.Id and not source.Link then
        return false, "no_source"
    end

    local sdkErr
    if source.Id then
        local previous = lib.script_id
        lib.script_id = source.Id

        local ok, a, b = pcall(lib.load_script)
        local good, err = sdkLoadResult(ok, a, b)
        if good then
            return true
        end

        lib.script_id = previous
        if not source.Link then
            return false, "sdk", err
        end
        sdkErr = err
    end

    local good, reason, detail = downloadAndRun(source.Link, key)
    if good then
        return true
    end
    return false, reason, detail, sdkErr
end

local loadReasons = {
    no_source = "no script configured. Set Junkie.ScriptId to the public token of your script",
    bad_url = "Junkie.ScriptId is not a valid script id or link",
    sdk = "Junkie load_script failed",
    http = "script download failed",
    compile = "downloaded file is not valid Lua",
    runtime = "script errored while running",
}

-- long text for the console and Result.LoadError
local function loadFailureLog(reason, detail, sdkErr)
    local text = loadReasons[reason] or tostring(reason)
    if detail ~= nil and detail ~= "" then
        text = text .. ": " .. tostring(detail)
    end
    if reason == "http" and tostring(detail):find("HTTP 404", 1, true) then
        text = text .. ". Check the link and script id, and that the script is published as public in the Junkie dashboard"
    end
    if sdkErr ~= nil and reason ~= "sdk" then
        text = text .. " (Junkie SDK: " .. tostring(sdkErr) .. ")"
    end
    return text
end

-- short text for the toast
local function loadToastText(reason, detail)
    detail = tostring(detail or "")
    if reason == "no_source" then
        return "No script set. Add your Junkie.ScriptId."
    elseif reason == "bad_url" then
        return "ScriptId is not a valid script id or link."
    elseif reason == "http" then
        if detail:find("HTTP 404", 1, true) then
            return "Script not found (HTTP 404). Check the link / script id."
        end
        return "Download failed: " .. detail:sub(1, 45)
    elseif reason == "compile" then
        return "The downloaded file is not a valid Lua script."
    elseif reason == "runtime" then
        return "The script errored while running. Check the console."
    end
    return "Junkie could not load the script: " .. detail:sub(1, 40)
end

