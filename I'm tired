-- notifications
--
--   Toolkit:Notify(title, text, kind, opts)
--     kind: "info" | "loading" | "success" | "warn" | "error"
--     opts: Duration, Tag, Fill, Color, Icon
--   Returns a handle with :Dismiss(instant).
--
--   Toolkit:Notify("Saved", "Settings stored.", "success", { Duration = 3, Tag = "save" })
--   (a new toast with the same Tag replaces the old one)
--
-- The toasts live in their own gui, so they outlast the key window.
----------------------------------------------------------------

local TOAST = {
    Height = 68,
    Radius = 20,
    Gap = 10,
    Margin = 16,
}

local notif = { Gui = nil, Holder = nil, Width = 300, Toasts = {}, Counter = 0 }
local emptyToast = { Dismiss = function() end }

local function ensureNotif()
    if notif.Gui and notif.Gui.Parent and notif.Holder and notif.Holder.Parent then
        return true
    end

    removeGui(Toolkit.NotifName)

    local camera = workspace.CurrentCamera
    local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
    notif.Width = math.clamp(viewport.X - TOAST.Margin * 2, 230, 300)
    notif.Toasts = {}

    notif.Gui = newScreenGui(Toolkit.NotifName, 1000000)
    notif.Holder = make("Frame", {
        Name = "Holder",
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -TOAST.Margin, 1, -TOAST.Margin),
        Size = UDim2.new(0, notif.Width, 1, -TOAST.Margin * 2),
        BackgroundTransparency = 1,
    }, notif.Gui)

    make("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
        VerticalAlignment = Enum.VerticalAlignment.Bottom,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, TOAST.Gap),
    }, notif.Holder)

    return true
end

function Toolkit:Notify(title, text, kind, opts)
    if not ensureNotif() then
        return emptyToast
    end

    opts = opts or {}
    local style = kindStyle(kind)
    local color = opts.Color or style.Color
    local icon = opts.Icon or style.Icon
    local fill = opts.Fill == true
    local duration = opts.Duration or Toolkit.Notifications.Duration
    local maxToasts = Toolkit.Notifications.Max
    local offscreenX = notif.Width + 40
    local toasts = notif.Toasts

    if opts.Tag then
        for _, toast in ipairs({ table.unpack(toasts) }) do
            if toast.Tag == opts.Tag then
                toast.Dismiss(true)
            end
        end
    end
    while #toasts >= maxToasts do
        toasts[1].Dismiss(true)
    end

    notif.Counter = notif.Counter + 1

    local wrap = make("Frame", {
        Name = "Toast",
        Size = UDim2.new(1, 0, 0, TOAST.Height),
        BackgroundTransparency = 1,
        LayoutOrder = -notif.Counter,
    }, notif.Holder)
    local slider = make("Frame", {
        Size = UDim2.fromScale(1, 1),
        Position = UDim2.fromOffset(offscreenX, 0),
        BackgroundTransparency = 1,
    }, wrap)

    addGlow(slider, color, 46, 0.84, 1)

    local card = make("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = WHITE,
        BorderSizePixel = 0,
        ZIndex = 2,
    }, slider)
    addCorner(card, TOAST.Radius)
    addGradient(card, theme.Bg2, theme.Bg, 135)
    local cardStroke = addStroke(card, WHITE, 1.5, 0.2)
    addGradient(cardStroke, color, theme.Stroke, 45)

    local badge = make("Frame", {
        Position = UDim2.fromOffset(14, 12),
        Size = UDim2.fromOffset(36, 36),
        BackgroundColor3 = color,
        BackgroundTransparency = 0.82,
        BorderSizePixel = 0,
        ZIndex = 3,
    }, card)
    addCorner(badge, 18)
    addStroke(badge, color, 1.2, 0.55)
    local badgePop = make("UIScale", { Scale = 0 }, badge)
    makeLabel(badge, {
        Size = UDim2.fromScale(1, 1),
        Text = icon,
        TextColor3 = color,
        TextSize = 17,
        Font = Enum.Font.GothamBlack,
        TextXAlignment = Enum.TextXAlignment.Center,
        ZIndex = 4,
    })

    makeLabel(card, {
        Position = UDim2.fromOffset(62, 10),
        Size = UDim2.new(1, -76, 0, 16),
        Text = title,
        TextSize = 13,
        Font = Enum.Font.GothamBold,
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = 3,
    })
    makeLabel(card, {
        Position = UDim2.fromOffset(62, 27),
        Size = UDim2.new(1, -76, 0, 26),
        Text = text,
        TextColor3 = theme.Muted,
        TextSize = 11,
        TextWrapped = true,
        TextYAlignment = Enum.TextYAlignment.Top,
        ZIndex = 3,
    })

    local track = make("Frame", {
        Position = UDim2.new(0, 18, 1, -12),
        Size = UDim2.new(1, -36, 0, 4),
        BackgroundColor3 = color,
        BackgroundTransparency = 0.85,
        BorderSizePixel = 0,
        ZIndex = 3,
    }, card)
    addCorner(track, 2)
    local bar = make("Frame", {
        Size = fill and UDim2.fromScale(0, 1) or UDim2.fromScale(1, 1),
        BackgroundColor3 = WHITE,
        BorderSizePixel = 0,
        ZIndex = 4,
    }, track)
    addCorner(bar, 2)
    addGradient(bar, color, color:Lerp(WHITE, 0.45), 0)

    local handle = { Tag = opts.Tag, Gone = false }
    table.insert(toasts, handle)

    function handle.Dismiss(instant)
        if handle.Gone then return end
        handle.Gone = true

        local index = table.find(toasts, handle)
        if index then
            table.remove(toasts, index)
        end

        if instant == true then
            pcall(function() wrap:Destroy() end)
            return
        end

        tween(slider, 0.25, { Position = UDim2.fromOffset(offscreenX, 0) }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        task.delay(0.25, function()
            if wrap.Parent then
                tween(wrap, 0.18, { Size = UDim2.new(1, 0, 0, 0) })
            end
            task.delay(0.2, function()
                pcall(function() wrap:Destroy() end)
            end)
        end)
    end

    local click = make("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        ZIndex = 8,
    }, card)
    click.MouseButton1Click:Connect(function() handle.Dismiss() end)
    click.MouseEnter:Connect(function() tween(cardStroke, 0.15, { Transparency = 0 }) end)
    click.MouseLeave:Connect(function() tween(cardStroke, 0.15, { Transparency = 0.2 }) end)

    tween(slider, 0.45, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Back)
    task.delay(0.15, function()
        if not handle.Gone then
            tween(badgePop, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
        end
    end)

    -- Fill toasts stay until dismissed (or 15s after the bar is full)
    if fill then
        tween(bar, duration, { Size = UDim2.fromScale(1, 1) }, Enum.EasingStyle.Linear)
        task.delay(duration + 15, handle.Dismiss)
    else
        tween(bar, duration, { Size = UDim2.fromScale(0, 1) }, Enum.EasingStyle.Linear)
        task.delay(duration, handle.Dismiss)
    end

    return handle
end

