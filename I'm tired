-- launcher
--   Toolkit:Launcher(options) -> { Destroy, Show, Hide, SetStatus, Wait, IsVerified }
----------------------------------------------------------------

function Toolkit:Launcher(options)
    local cfg = deepMerge(Toolkit.Defaults, options)

    -- shorthand options, same idea as the Mercenary loaders:
    --   Service / Identifier / Provider / ScriptId -> Junkie.*
    --   OnSuccess -> OnVerified, Storage.FileName -> KeyFile
    --   Links.Discord / Links.GetKey, Appearance.Title / Subtitle
    for _, key in ipairs({ "Service", "Identifier", "Provider", "ScriptId" }) do
        if cfg[key] ~= nil then
            cfg.Junkie[key] = cfg[key]
        end
    end
    if type(cfg.OnSuccess) == "function" and cfg.OnVerified == nil then
        cfg.OnVerified = cfg.OnSuccess
    end
    if type(cfg.Storage) == "table" and cfg.Storage.FileName and cfg.KeyFile == nil then
        cfg.KeyFile = tostring(cfg.Storage.FileName)
    end
    if type(cfg.Links) == "table" then
        if cfg.Links.Discord and (cfg.Discord == nil or cfg.Discord == "") then
            cfg.Discord = cfg.Links.Discord
        end
        if cfg.Links.GetKey and (cfg.GetKeyLink == nil or cfg.GetKeyLink == "") then
            cfg.GetKeyLink = cfg.Links.GetKey
        end
    end
    if type(cfg.Appearance) == "table" then
        if cfg.Appearance.Title then cfg.Title = cfg.Appearance.Title end
        if cfg.Appearance.Subtitle then cfg.Tagline = cfg.Appearance.Subtitle end
    end

    cfg.KeyFile = cfg.KeyFile or (cfg.Name .. "_Key.txt")

    Toolkit:SetTheme(cfg.Theme)
    if type(options) == "table" and type(options.Notifications) == "table" then
        for key, value in pairs(options.Notifications) do
            Toolkit.Notifications[key] = value
        end
    end

    if Toolkit._Active then
        pcall(Toolkit._Active.Destroy, true)
    end
    removeGui(cfg.Name)

    local handle = {}

    -- games list: a matching entry swaps ScriptId for its own Premium / Freemium links
    local gamesReady = false
    task.spawn(function()
        local games = cfg.Games
        if type(games) ~= "table" and type(cfg.GamesUrl) == "string" and cfg.GamesUrl ~= "" then
            games = fetchGames(cfg.GamesUrl)
        end
        local entry = findGame(games)
        if entry then
            cfg.Junkie.ScriptId = { Premium = entry.Premium, Freemium = entry.Freemium }
            env.TOOLKIT_GAME = entry.Name
        end
        gamesReady = true
    end)

    local acceptsAnyTier = cfg.Premium == "both" or cfg.Premium == "auto"
    local isPremium = cfg.Premium == true
    local enforceTier = cfg.EnforceTier ~= false and not acceptsAnyTier

    -- start the SDK download right away
    local sdkLib, sdkDone, sdkError = nil, false, nil
    task.spawn(function()
        sdkLib, sdkError = loadSdk(cfg.Junkie.SDKUrl)
        if not sdkLib then
            warn("[Toolkit] Junkie SDK failed to load: " .. tostring(sdkError))
        end
        sdkDone = true
    end)

    local screenGui = newScreenGui(cfg.Name, 999999)

    local destroyed, busy, hidden = false, false, false
    local verified = false
    env.TOOLKIT_KEY_VERIFIED = false
    local connections = {}
    local junkie = nil

    local function connect(signal, fn)
        local connection = signal:Connect(fn)
        table.insert(connections, connection)
        return connection
    end

    ------------------------------------------------------------
    -- window
    ------------------------------------------------------------
    local function computeScale()
        local camera = workspace.CurrentCamera
        local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
        return math.clamp(math.min((viewport.X - 24) / BASE_WIDTH, (viewport.Y - 24) / BASE_HEIGHT), 0.5, 1.1)
